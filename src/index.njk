---
layout: base.njk
claseCuerpo: inicio
---
{% set recientes = collections.cuaderno | recientes(4) %}
{% set ultima = recientes[0] %}
<section class="bento envoltura" aria-label="Inicio">

  <!-- Titular -->
  <div class="t t-titular">
    <p class="etiqueta">Cuaderno · sistemas · complejidad · tiempo · ser</p>
    <h1 class="b-titular">
      <span>El sentido común</span>
      <span class="c-ser">ya no es común.</span>
      <span class="c-tiempo">Ni tiene sentido.</span>
    </h1>
    <p class="mono-suave">Sabemos más.<br>Nos falta distinguirlo.<span class="cursor" aria-hidden="true">_</span></p>
  </div>

  <!-- La marca, al centro -->
  <div class="t t-marca" id="tanmayo-marca">
    <svg class="anillos" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="120"></circle>
      <circle cx="200" cy="200" r="160"></circle>
      <circle cx="200" cy="200" r="196"></circle>
    </svg>
    <svg class="marca marca-bento" viewBox="0 0 120 140" role="img" aria-label="Tanmayo">
      <g class="orbita o1"><g class="orbita-y"><circle class="punto p1" cx="33" cy="25" r="8.5"></circle></g></g>
      <g class="orbita o2"><g class="orbita-y"><circle class="punto p2" cx="60" cy="23" r="8.5"></circle></g></g>
      <g class="orbita o3"><g class="orbita-y"><circle class="punto p3" cx="87" cy="25" r="8.5"></circle></g></g>
      <path class="trazo" d="M8 58 C18 48 44 44 70 43 C88 42 104 42 114 40 C112 44 108 47 102 48 C82 50 52 52 30 58 C22 60 16 64 12 68 C8 66 6 62 8 58 Z"></path>
      <path class="trazo" d="M60 46 C66 45 70 47 69 52 C66 76 64 104 62 134 C58 128 55 108 54 84 C53 68 54 54 60 46 Z"></path>
    </svg>
    <p class="marca-pie-texto"><span>Tanmayo</span> · ver distinto antes de hacer distinto</p>
  </div>

  <!-- Sobre mí -->
  <div class="t t-sobre" id="sobre">
    <p class="etiqueta">Sobre mí</p>
    <p class="b-texto">Soy <strong>Sergio Guevara</strong>. Enseño agilidad, cultura y complejidad, acompaño a una organización financiera compleja, escribo y facilito talleres.</p>
    <a class="enlace-mono abajo" href="{{ site.linkedin }}">LinkedIn ↗</a>
  </div>

  <!-- Años -->
  <div class="t t-anos">
    <p class="b-numero"><span class="contador" data-hasta="20">20</span>+</p>
    <p class="b-texto suave">años entre proyectos, producto, complejidad y equipos globales.</p>
  </div>

  <!-- Última nota -->
  {% if ultima %}
  <a class="t t-nota tema-{{ ultima.data.tema | slugTema }}" href="{{ ultima.url }}">
    <span class="nota-meta"><span class="punto-tema" aria-hidden="true"></span>Última nota · {{ ultima.data.tema }} · {{ collections.cuaderno | numero(ultima.url) }}</span>
    <span class="b-nota-titulo">{{ ultima.data.title }}</span>
    <span class="b-texto suave">{{ ultima.data.extracto }}</span>
    <span class="enlace-mono abajo">Leer nota →</span>
  </a>
  {% endif %}


  <!-- Conversemos -->
  <a class="t t-conv" href="{{ site.linkedin }}">
    <span class="etiqueta">¿Tu equipo se esfuerza y no avanza?</span>
    <span class="b-conv">Conver&shy;semos <span class="flecha">↗</span></span>
  </a>

  <!-- Compás Anímico -->
  <a class="t t-compas" href="/compas-animico/">
    <img src="/assets/img/compas-portada.jpg" alt="Portada de El Pequeño Libro del Compás Anímico" width="1358" height="1048" loading="lazy">
    <div class="compas-lado">
      <span class="etiqueta">Libro · 20 principios</span>
      <ul class="principios-rota" data-rota>
        {% for p in principios %}
        <li{% if loop.first %} class="activo"{% endif %}><span class="pr-n">{{ p.n }}</span><span class="pr-t">{{ p.frase }}</span></li>
        {% endfor %}
      </ul>
      <span class="enlace-mono abajo">El Pequeño Libro del Compás Anímico →</span>
    </div>
  </a>

  <!-- Tanmayo -->
  <div class="t t-tanmayo" id="tanmayo">
    <p class="etiqueta">La práctica</p>
    <p class="b-tanmayo" aria-label="Tanmayo">Tanmayo</p>
    <p class="b-texto">Ideas que se vuelven trabajo. No otro framework ágil: ABCs para re-pensar y distinguir.</p>
    <div class="chips-fijas">
      <span class="chip-fija"><span class="punto-tema f-sistemas"></span>Organizaciones</span>
      <span class="chip-fija"><span class="punto-tema f-tiempo"></span>Equipos</span>
      <span class="chip-fija"><span class="punto-tema f-ser"></span>Líderes</span>
    </div>
  </div>


  <!-- Cuaderno -->
  <div class="t t-lista" id="cuaderno">
    <div class="lista-cabeza">
      <p class="b-cuaderno">Cuaderno</p>
      <a class="enlace-mono" href="/cuaderno/">Todo el cuaderno →</a>
    </div>
    <ul class="lista-compacta">
      {% for n in recientes %}{% if not loop.first %}
      <li class="tema-{{ n.data.tema | slugTema }}"><a href="{{ n.url }}">
        <span class="nota-meta"><span class="punto-tema" aria-hidden="true"></span>{{ n.data.tipo }} · {{ n.data.tema }}</span>
        <span class="lc-titulo">{{ n.data.title }}</span>
        <span class="nota-flecha" aria-hidden="true">→</span>
      </a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>

  <!-- IA / suscribirse -->
  <div class="t t-ia">
    <p class="etiqueta">Pregúntale a tu IA</p>
    <p class="b-texto">Todo mi pensamiento, legible para asistentes de IA.</p>
    <a class="enlace-mono" href="/llms.txt">sguevara.com/llms.txt ↗</a>
    <p class="enlace-mono abajo"><a href="/feed.xml">RSS</a> · <a href="{{ site.linkedin }}">LinkedIn</a></p>
  </div>
</section>
