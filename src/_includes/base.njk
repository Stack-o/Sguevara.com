<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set tituloPagina = (title + " — " + site.titulo) if title else (site.titulo + " — Tanmayo y anotaciones") %}
  <title>{{ tituloPagina }}</title>
  <meta name="description" content="{{ extracto or descripcion or site.descripcion }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ tituloPagina }}">
  <meta property="og:description" content="{{ extracto or descripcion or site.descripcion }}">
  <meta property="og:type" content="{{ 'article' if tipo else 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/{{ imagenCompartir or 'compartir.png' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#EFE5D0" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#191612" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="Anotaciones — Sergio Guevara" href="/feed.xml">
  <link rel="preload" href="/assets/fonts/gloock-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{{ claseCuerpo }}">
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <header class="cabecera envoltura">
    <a class="logo" href="/" aria-label="Sergio Guevara — inicio">
      {% set claseMarca = "marca-nav" %}{% include "marca.njk" %}
      <span>Sergio Guevara Guitián</span>
    </a>
    {% set enInicio = page.url == "/" %}
    {% set enArq = page.url == "/tanmayo/" %}
    {% set enLibros = page.url.startsWith("/anotaciones") or page.url.startsWith("/compas-animico") %}
    <nav class="menu" aria-label="Principal">
      <a href="{{ '' if enInicio else '/' }}#distinguir" data-seccion="distinguir">Distinguir</a>
      <a href="{{ '' if enInicio else '/' }}#arquitectura" data-seccion="arquitectura"{% if enArq %} aria-current="true"{% endif %}>Arquitectura</a>
      <a href="{{ '' if enInicio else '/' }}#libros" data-seccion="libros"{% if enLibros %} aria-current="true"{% endif %}>Libros<span class="menu-largo"> y anotaciones</span></a>
      <a class="menu-externo" href="{{ site.linkedin }}">LinkedIn</a>
    </nav>
  </header>

  <main id="contenido">
    {{ content | safe }}
  </main>

  <footer class="pie envoltura" id="conversemos">
    {% if page.url != "/" %}<a class="volver-inicio" href="/">← Volver al inicio</a>{% endif %}
    <div class="pie-grande">
      {% set claseMarca = "marca-pie" %}{% include "marca.njk" %}
      <a class="conversemos" href="{{ site.linkedin }}">Sigamos la conversación en LinkedIn <span class="c-tiempo">↗</span></a>
    </div>
    <div class="pie-linea">
      <span>{{ site.autor }} · sguevara.com</span>
      <span>
        {% if site.correo %}<a href="mailto:{{ site.correo }}">{{ site.correo }}</a> · {% endif %}
        <a href="{{ site.linkedin }}">LinkedIn</a> · <a href="/feed.xml">RSS</a> · <a href="/llms.txt">llms.txt</a>
      </span>
    </div>
  </footer>
  <script src="/assets/js/sitio.js" defer></script>
</body>
</html>
